# Copy this file to .env and fill in the values. Never commit .env.

# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Server ID(s) the bot runs in, comma-separated (Discord: Settings -> Advanced -> Developer Mode,
# then right-click the server icon -> Copy Server ID). Example: GUILD_ID=111111111111111111,222222222222222222
GUILD_ID=

# Dynasty Google Sheet: File -> Share -> Publish to web -> "Entire document" link.
SHEET_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vRIVVmDgwxWVbvAAIDrMgH6cpb08pkPGPWX2M66r8HKYyX_UxursTZjtF_SiH9w6CEJswQ_fsmOXXME/pubhtml
